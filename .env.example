# ---------------------------------------------------------------------------
# Configuration for the Docker deployment.
#
#   cp .env.example .env      then edit .env
#
# `docker compose` reads .env from this directory automatically — there is
# nothing to import or source. `docker-compose.yaml` substitutes these values,
# each with a fallback, so a missing .env still starts with sane defaults.
#
# .env is gitignored; this example file is committed. Neither is encrypted, so
# nothing secret belongs in either — and nothing here is secret: this app has no
# API keys, and the access codes live in the database, not in config.
#
# After changing anything here, apply it with:  ./scripts/redeploy.sh
# ---------------------------------------------------------------------------


# The origin visitors actually type or scan. **Set this in production.**
#
# It is the origin baked into every QR code you generate and every link you copy
# out of /admin. Those are printed on cards and pasted into messages, so getting
# it wrong is expensive: a printed QR pointing at the wrong host cannot be
# recalled.
#
# It must NOT be the container's internal address. Inside the container the app
# is listening on localhost:3000, and a Next route handler derives its own
# origin from that listening address rather than from the Host header the proxy
# forwards — which is exactly why this value has to be stated explicitly rather
# than discovered.
#
# No trailing slash. Include the scheme.
FK_PUBLIC_ORIGIN=https://home.finnkrause.com


# Where the SQLite database lives *inside* the container.
#
# Deliberately left commented out. This file is read by **two** programs:
# `docker compose` substitutes it into docker-compose.yaml, and Next.js also
# loads it on the host during `npm run dev` and `npm run build`. `/app/data` is
# a path inside the container and does not exist on your machine, so setting it
# here points the dev server at a directory it cannot create — and every route
# that touches the database 500s. That includes /api/access, so you cannot get
# through the gate locally at all.
#
# Leaving it unset costs the deployment nothing: docker-compose.yaml already
# defaults it to exactly this value, and in development the app falls back to
# ./data/access.db next to this file.
#
# If you do uncomment it, it must match the mount point of the bind mount
# below. Changing it without changing FK_DATA_DIR means the database is written
# into the container's own filesystem and is lost on the next redeploy.
#FK_DB_PATH=/app/data/access.db


# Where the database lives *on the host* — the other end of that bind mount.
#
# Relative to this directory. This folder holds every access code you have ever
# handed out; it is the one irreplaceable thing in the deployment. Back it up.
FK_DATA_DIR=./data


# The port published on the host. The reverse proxy in front of this app should
# forward to it. The container always listens on 3000 internally.
FK_HOST_PORT=8070


# Timezone for the container, which is what timestamps in the admin dashboard
# and the event log are rendered against.
TZ=Europe/Berlin
