# Build context exclusions.
#
# Critical: node_modules must NEVER be copied. The image installs and compiles
# better-sqlite3 for linux-musl in an earlier layer; copying a host-built
# node_modules over it replaces the native binary with a darwin/win32 one and
# the container fails to start.

node_modules
.next
out
build

# The live database. Production data belongs in the mounted volume, not in an
# image layer.
data

# Source media project files — not part of the site.
VideoEdits

.git
.gitignore
.dockerignore
dockerfile
docker-compose.yaml

*.tsbuildinfo
next-env.d.ts

.env
.env*.local
.vscode
.idea
.claude
.DS_Store
*.xmp
*.pem
npm-debug.log*
