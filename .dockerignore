# Build context exclusions.
#
# Critical: node_modules must NEVER be copied. The image compiles
# better-sqlite3 for linux-musl in an earlier layer; copying a host-built
# node_modules over it replaces the native binary with a darwin/win32 one and
# the container fails to start.

node_modules
.next
out
build

# The live database. It is a bind mount from ./data at runtime; production data
# has no business inside an image layer, and excluding it keeps the build
# context small as the database grows.
data

# Not needed to build or run the image.
scripts
docs
README.md
VideoEdits

.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yaml

*.tsbuildinfo
next-env.d.ts

.env
.env*.local
.vscode
.idea
.claude
.DS_Store
*.xmp
*.pem
npm-debug.log*
